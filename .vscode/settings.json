{
  "editor.tabSize": 2,
  "eslint.format.enable": true,
  "editor.detectIndentation": false,
  "editor.indentSize": "tabSize",
  "files.eol": "\n",
  "eslint.runtime": "node",
  "mdc.enableFormatting": true,
  "npm.packageManager": "pnpm",
  "cSpell.ignorePaths": [
    "package-lock.json",
    ".gitignore",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "pnpm-lock.yaml",
    "CHANGELOG.md"
  ],
  "eslint.validate": [
    "javascript",
    "typescript",
    "json",
    "jsonc",
    "json5",
    "html",
    "markdown",
    "yaml",
    "yml"
  ],
  "cSpell.words": [
    "Emeka",
    "esbuild",
    "favorodera",
    "queryability",
    "relizy",
    "safeint",
    "strftime",
    "tsdown",
    "validatable",
    "vite",
    "vitest"
  ]
}