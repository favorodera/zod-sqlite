{
  "name": "zod-sqlite",
  "type": "module",
  "version": "1.0.3",
  "private": false,
  "packageManager": "pnpm@11.20.0",
  "description": "Generate type-safe SQLite table schemas from Zod validation schemas.",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://github.com/favorodera/zod-sqlite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/zod-sqlite.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/zod-sqlite/issues"
  },
  "keywords": [
    "zod",
    "sqlite",
    "database",
    "schema",
    "validation",
    "zod-to-sqlite"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch --ui",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "lint": "eslint . --fix",
    "ready": "pnpm install && pnpm build && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "zod": "catalog:vendor"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "db0": "catalog:dev",
    "eslint": "catalog:dev",
    "relizy": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
